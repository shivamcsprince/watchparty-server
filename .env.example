PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173
# Neon connection string. If it ends in sslmode=require, change it to sslmode=verify-full
# (same security, avoids a warning from the pg library). Keep the real value ONLY in .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full
# Secret used to sign login tokens. At least 32 characters, random, never committed.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional tuning (defaults shown). On Render set TRUST_PROXY=1.
# TRUST_PROXY=0
# BCRYPT_ROUNDS=10
# AUTH_RATE_LIMIT_MAX=30
